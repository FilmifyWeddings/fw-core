{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "lib": ["ES2022"],
    "outDir": "./dist",
    "rootDir": "./",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "moduleResolution": "NodeNext",
    "declaration": false,
    "sourceMap": false
  },
  "include": [
    "server.ts",
    "supabase-auth-state.ts"
  ],
  "exclude": ["node_modules", "dist"]
}
